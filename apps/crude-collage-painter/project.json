{
  "name": "crude-collage-painter",
  "sourceRoot": "apps/crude-collage-painter/src",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "@nx/vite:dev-server",
      "options": {
        "buildTarget": "crude-collage-painter:build",
        "port": 5174
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/crude-collage-painter",
        "configFile": "apps/crude-collage-painter/vite.config.js"
      }
    },
    "preview": {
      "executor": "@nx/vite:preview-server",
      "options": {
        "buildTarget": "crude-collage-painter:build",
        "port": 4174
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/crude-collage-painter/**/*.{js,jsx}"]
      }
    },
    "test": {
      "executor": "@nx/playwright:playwright",
      "options": {
        "config": "apps/crude-collage-painter/playwright.config.js"
      },
      "configurations": {
        "ci": {
          "forbidOnly": true,
          "workers": 1
        }
      },
      "env": {
        "TEST_APP": "crude-collage-painter"
      }
    },
    "deploy": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "npx gh-pages -d dist/apps/crude-collage-painter --repo https://github.com/michaelpaulukonis/crude-collage-painter.git"
      }
    },
    "release-deploy": {
      "dependsOn": ["build", "validate-version"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx release --projects=crude-collage-painter",
          "npx gh-pages -d dist/apps/crude-collage-painter --repo https://github.com/michaelpaulukonis/crude-collage-painter.git"
        ],
        "parallel": false
      }
    }
  }
}