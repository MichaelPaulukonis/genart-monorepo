{
  "name": "genart-monorepo",
  "version": "0.1.0",
  "description": "Monorepo for creative coding and generative art projects",
  "scripts": {
    "dev": "nx run-many --target=dev --all",
    "build": "nx run-many --target=build",
    "deploy": "nx run-many --target=deploy",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "test:e2e": "nx run-many --target=build --all && nx run-many --target=e2e --all",
    "test:e2e:ui": "nx run-many --target=e2e --all -- --ui",
    "test:e2e:debug": "nx run-many --target=e2e --all -- --debug",
    "test:e2e:update": "nx run-many --target=e2e --all -- --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "test:verify": "node test/scripts/verify-utilities.js",
    "test:verify:basic": "node test/scripts/verify-utilities.js --basic",
    "test:verify:light": "node --max-old-space-size=2048 test/scripts/verify-utilities.js --basic",
    "gen:changelog": "node scripts/generate-workspace-changelog.js",
    "gen:changelog:apply": "node scripts/generate-workspace-changelog.js --apply",
    "test:debug": "node test/scripts/debug-test.js",
    "validate:version-display": "node scripts/validate-version-display-accessibility.js",
    "validate:app": "node scripts/validate-app-version-display.js",
    "validate:all": "npm run validate:version-display"
  },
  "devDependencies": {
    "@nx/eslint": "^21.6.4",
    "@nx/js": "^21.6.4",
    "@nx/playwright": "21.6.4",
    "@nx/vite": "^21.6.4",
    "@playwright/test": "^1.40.0",
    "@vitest/ui": "^4.0.14",
    "eslint": "^8.57.1",
    "eslint-plugin-p5js": "^1.0.0",
    "fast-check": "^4.3.0",
    "gh-pages": "^6.3.0",
    "http-server": "^14.1.1",
    "jsdom": "^27.2.0",
    "nx": "^21.6.4",
    "serve": "^14.2.5",
    "standard": "^17.1.2",
    "vite": "^5.0.0",
    "vitest": "^4.0.14"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "dependencies": {
    "cross-env": "^10.1.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "p5": "^1.11.10",
    "p5js-wrapper": "^1.2.3",
    "pngjs": "^7.0.0",
    "tweakpane": "^4.0.5"
  }
}
